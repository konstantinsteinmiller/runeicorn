{
  "name": "runeicorn",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Rune-icorn: Duels — 13kB magic casting game",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "node tools/build.mjs",
    "build:squeeze": "node tools/build.mjs --squeeze",
    "squeeze": "node tools/build.mjs --squeeze",
    "squeeze:fast": "node tools/build.mjs --squeeze --reuse-params",
    "squeeze:props": "node tools/build.mjs --squeeze --mangle-all-props",
    "size": "node tools/size.mjs",
    "check": "node tools/build.mjs --squeeze --mangle-all-props --strict",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "release": "node tools/build.mjs --squeeze --mangle-all-props --strict",
    "build:wavedash": "node tools/build.mjs --squeeze --mangle-all-props --wavedash --out=wavedash-dist --budget=13k",
    "push:wavedash": "pnpm build:wavedash && wavedash build push"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@gfx/zopfli": "^1.0.15",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "html-minifier-terser": "^7.2.0",
    "roadroller": "^2.1.0",
    "terser": "^5.50.0"
  }
}
